# Neon Postgres
# Pooled connection string used by the app at runtime
DATABASE_URL=
# Direct (unpooled) connection string used by drizzle-kit for migrations
DATABASE_URL_UNPOOLED=

# Resend transactional email (used for /submit notifications)
RESEND_API_KEY=
ADMIN_EMAIL=

# Google Places — used by the import script only, not at runtime
GOOGLE_PLACES_API_KEY=

# MapLibre tiles. Protomaps or MapTiler free tier both work.
# e.g. https://api.maptiler.com/maps/streets-v2/style.json?key=YOUR_KEY
MAPLIBRE_TILES_URL=
NEXT_PUBLIC_MAPLIBRE_TILES_URL=

# Public site URL for sitemap, OG, canonical links
NEXT_PUBLIC_SITE_URL=https://whoownsmylumberyard.com
